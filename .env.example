# ---- API ----
API_KEYS=dev-key-change-me
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# ---- Language model ----
# auto | anthropic | azure | bedrock | openai
# Leave as auto to use whichever block below is filled in.
LLM_PROVIDER=auto

# Anthropic does not provide embeddings. To enable meaning-based search
# alongside it, name a separate embedding source here and fill in its block.
# none | local | azure | bedrock | openai
#   local — a sentence-transformers model in this process: no API key, no
#           per-call cost, and no text leaves the host
EMBEDDING_PROVIDER=none

# Local embedding model settings (used when EMBEDDING_PROVIDER=local)
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOCAL_EMBEDDING_DEVICE=
LOCAL_EMBEDDING_BATCH_SIZE=32

# Option A — Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Option B — Anthropic (simplest: one API key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_BASE_URL=

# Option C — Amazon Bedrock
# Leave the keys blank to use an instance role, or set AWS_PROFILE for a
# named local profile. BEDROCK_ENDPOINT_URL is only needed for a VPC endpoint.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=
BEDROCK_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=
BEDROCK_MAX_TOKENS=4096
BEDROCK_EMBEDDING_DIMENSIONS=0
BEDROCK_ENDPOINT_URL=

# Option D — any OpenAI-compatible endpoint
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=

# ---- Extraction ----
EXTRACTION_CONCURRENCY=6
EXTRACTION_TIMEOUT_SECONDS=90
ROWS_PER_CHUNK=50
CHUNK_SIZE=2000
CHUNK_OVERLAP=200

# ---- Storage ----
# local — file-backed graph on this host (portable, no dependencies)
# cloud — the shared managed graph service
# dual  — write to both; read locally for speed, mirror to the shared graph
GRAPH_BACKEND=local
DATA_DIR=./data
COSMOS_GREMLIN_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=GraphDatabase
COSMOS_COLLECTION=KnowledgeGraph

# ---- Fine-tuning ----
# Which hosted fine-tuning surface to use: azure | openai
TRAINING_PROVIDER_MODE=azure
AZURE_FINETUNE_API_VERSION=2024-10-21
# Comma-separated base models offered in the console
TRAINING_BASE_MODELS=
# Amazon Bedrock customisation (needs both to be set before it is offered)
BEDROCK_TRAINING_BASE_MODELS=
BEDROCK_TRAINING_ROLE_ARN=
BEDROCK_TRAINING_S3_URI=
# Inference-only services are listed so the console can explain the limitation
GROQ_API_KEY=
# Training on your own hardware — see worker/README.md
TRAINING_WORKER_URL=
TRAINING_WORKER_TOKEN=
TRAINING_WORKER_BASE_MODELS=

# ---- Retrieval ----
RETRIEVER=keyword
# Keep the source chunks uploaded files were read from, so questions can be
# answered from the original wording with no external search service.
CAPTURE_PASSAGES=true

# ---- Azure AI Search (hybrid document retrieval) ----
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=
AZURE_SEARCH_VECTOR_FIELD=text_vector
AZURE_SEARCH_SEMANTIC_CONFIG=
AZURE_SEARCH_TIMEOUT_SECONDS=10
